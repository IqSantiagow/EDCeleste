Screen {
    background: $surface;
}

#app-container {
    grid-size: 2 4;
    grid-columns: 2fr 1fr;
    grid-rows: auto auto 1fr auto;
    grid-gutter: 1;
    keyline: thin $primary;
}

#app-header {
    column-span: 2;
    padding: 0 1 0 1;
}

#comms-title{
    width: 1fr;
    padding-left: 1;
}

#ship-log-title{
    width: 1fr;
    padding-left: 1;
}

#dashboard-stats-content {
    width: 0.8fr;
}

#dashboard-stats-content Rule{
    height:1;
}

#dashboard-jrnl-llm-status Rule{
    height:1;
}

#dashboard-title{
    color: $primary;
}

#dashboard-jrnl-llm-status {
    height: auto;
    align: right middle;
    width: 0.2fr;
}

WidgetCommonStatLabel {
    width: 20;
}

WidgetShipLogCol {
    row-span: 2;
    padding: 0 1 0 1;
}

WidgetShipLogEntry{
    padding: 0 0 1 0;
}

WidgetShipLogEntry > Label {
    padding: 0 1 0 0;
}

WidgetCommsCol {
    padding: 0 1 0 1;
}

#comms-scroll {
    height: 1fr;
}

WidgetCommsEntry{
    height: auto;
    padding: 0 0 1 0;
}


WidgetCommsEntry > .llm-response{
    color: $primary;
}

WidgetCommsEntry > .human-command{
    color: #2518d4;
}

Footer {
    background: $surface;
}

.text-bold {
    text-style: bold;
}

.shady {
    color: #6F4A24
}

.light {
    color: $secondary
}
