/* ============================================================
   Design tokens
   Only for colors the amber theme (ui/themes/themes.py) doesn't
   already provide. $primary / $secondary / $surface come from
   the active Theme — don't redefine them here.
   ============================================================ */
$font-muted-color: #6F4A24;
$human-command-color: #2518d4;

/* ============================================================
   App shell
   ============================================================ */
Screen,
Footer {
    background: $surface;
}

.screen-grid {
    grid-size: 2 4;
    grid-rows: auto auto 1fr auto;
    grid-gutter: 1;
    keyline: thin $primary;
}

#app-container {
    grid-columns: 2fr 1fr;
}

#settings-grid {
    grid-columns: 1fr 2fr;
}

Rule {
    height: 1;
}

/* Dev tool: add manually to any widget's classes to see its box
   during layout debugging. Not applied anywhere by default. */
.border-debug {
    border: solid red;
}

/* ============================================================
   Shared: outer gutter padding for the app's primary content
   containers (header bar, dashboard columns, settings columns)
   ============================================================ */
AppHeader,
WidgetShipLogCol,
WidgetCommsCol,
WidgetSettingsSectionsColumn,
WidgetPathsContainer,
WidgetKeybindsContainer,
WidgetEventReactionsContainer,
WidgetSystemPromptsContainer,
WidgetTTSContainer {
    padding: 0 1;
}

/* ============================================================
   Shared: header row + column titles
   ============================================================ */
#app-header {
    column-span: 2;
}

#dashboard-title {
    color: $primary;
    text-style: bold;
}

#settings-header-label {
    text-style: bold;
}

WidgetSettingsHeaderContent {
    width: 1fr;
}

#settings-header-modified-indicator {
    width: 1fr;
    align: right middle;
}

.header-title {
    width: 1fr;
    padding-left: 1;
    color: $font-muted-color;
}

/* ============================================================
   Shared components: WidgetSectionHeader, WidgetLabeledValueRow
   (ui/widgets/common/)
   ============================================================ */
.section-header-label {
    color: $font-muted-color;
}

.section-divider {
    margin: 0 0;
    keyline: thin $primary;
}

.entry-row {
    width: 0.7fr;
}

.entry-row-full {
    width: 1fr;
}

.entry-row .entry-label {
    color: $primary;
}

.entry-row .entry-value {
    width: 1fr;
}

.entry-value{
    padding: 0 0 0 1;
}

/* ============================================================
   Dashboard: stats header
   (DashboardStatsContent, WidgetCommonStatLabel)
   ============================================================ */
#dashboard-stats-content {
    width: 0.8fr;
}

#dashboard-jrnl-llm-status {
    height: auto;
    align: right middle;
    width: 0.2fr;
}

WidgetCommonStatLabel {
    width: 20;
}

WidgetCommonStatLabel .stat-key {
    color: $font-muted-color;
}

WidgetCommonStatLabel .stat-value {
    color: $secondary;
    text-style: bold;
}

/* ============================================================
   Dashboard: comms column
   (WidgetCommsCol, WidgetCommsEntry, WidgetCommsInput)
   ============================================================ */
#comms-scroll,
#ship-log-scroll {
    height: 1fr;
}

WidgetCommsEntry {
    height: auto;
    padding: 0 0 1 0;
}

.comms-entry-title {
    text-style: bold;
}

WidgetCommsEntry.user-command .comms-entry-title,
WidgetCommsEntry.user-command .comms-entry-content {
    color: $human-command-color;
}

WidgetCommsEntry.llm-response .comms-entry-title,
WidgetCommsEntry.llm-response .comms-entry-content {
    color: $primary;
}

WidgetCommsEntry.system-message .comms-entry-title,
WidgetCommsEntry.system-message .comms-entry-content {
    color: $font-muted-color;
}

/* ============================================================
   Dashboard: ship log column
   (WidgetShipLogCol, WidgetShipLogEntry)
   ============================================================ */
WidgetShipLogCol {
    row-span: 2;
}

WidgetShipLogEntry {
    padding: 0 0 1 0;
}

WidgetShipLogEntry > Label {
    padding: 0 1 0 0;
}

WidgetShipLogEntry .log-timestamp {
    color: $font-muted-color;
}

WidgetShipLogEntry .log-event {
    text-style: bold;
}

/* ============================================================
   Settings: sections sidebar (WidgetSettingsSectionsColumn)
   ============================================================ */
.section-nav-item {
    color: $font-muted-color;
    padding: 0 0 1 0;
}

WidgetSettingsSectionListItem {
    width: 1fr;
}

WidgetSettingsSectionListItem .section-label {
    width: 1fr;
}

/* ============================================================
   Settings: paths section
   ============================================================ */
WidgetPathsContainer .entry-label {
    width: 20;
}

/* ============================================================
   Settings: keybinds section
   ============================================================ */

WidgetKeybindsContainer .entry-row {
    padding: 1 0 0 0;
}

WidgetKeybindsContainer .entry-value {
    color: $primary;
    content-align: right middle;
}

WidgetLabeledDynamicInputRow {
    height: 3;
}

WidgetLabeledSelectRow {
    height: 1;
}

#settings-entry-row-container Label {
    height: 1fr;
    content-align: left middle;
}

#settings-entry-row-container .entry-input{
    padding: 0;
    height: 1fr;
    border: solid $primary;
}

#settings-entry-row-container .entry-select{
    padding: 0;
    height: 1;
}


.warning-label {
    color: $warning;
}

.warning-label.error {
    color: $error;
    background: transparent;
}

.warning-label.success {
    color: $success;
    background: transparent;
}

.hidden{
    display: none;
}
