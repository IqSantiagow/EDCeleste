/* ============================================================
   Design tokens
   Only for colors the amber theme (ui/themes/themes.py) doesn't
   already provide. $primary / $secondary / $surface come from
   the active Theme — don't redefine them here.
   ============================================================ */
$font-muted-color: #6F4A24;
$human-command-color: #2518d4;

/* ============================================================
   App shell
   ============================================================ */
Screen,
Footer {
    background: $surface;
}

.screen-grid {
    grid-size: 2 4;
    grid-rows: auto auto 1fr auto;
    grid-gutter: 1;
    keyline: thin $primary;
}

#app-container {
    grid-columns: 2fr 1fr;
}

#settings-grid {
    grid-columns: 1fr 2fr;
}

Rule {
    height: 1;
}

/* Dev tool: add manually to any widget's classes to see its box
   during layout debugging. Not applied anywhere by default. */
.border-debug {
    border: solid red;
}

/* ============================================================
   Shared: outer gutter padding for the app's primary content
   containers (header bar, dashboard columns, settings columns)
   ============================================================ */
AppHeader,
WidgetShipLogCol,
WidgetCommsCol,
WidgetSettingsSectionsColumn,
WidgetPathsContainer,
WidgetKeybindsContainer,
WidgetEventReactionsContainer,
WidgetSystemPromptsContainer,
WidgetTTSContainer {
    padding: 0 1;
}

/* ============================================================
   Shared: header row + column titles
   ============================================================ */
#app-header {
    column-span: 2;
}

#dashboard-title {
    color: $primary;
    text-style: bold;
}

#settings-header-label {
    text-style: bold;
}

WidgetSettingsHeaderContent {
    width: 1fr;
}

#settings-header-modified-indicator {
    width: 1fr;
    align: right middle;
}

.header-title {
    width: 1fr;
    padding-left: 1;
    color: $font-muted-color;
}

/* ============================================================
   Shared components: WidgetSectionHeader, WidgetLabeledValueRow
   (ui/widgets/common/)
   ============================================================ */
.section-header-label {
    color: $font-muted-color;
}

.section-divider {
    margin: 0 0;
    keyline: thin $primary;
}

.entry-row {
    width: 0.7fr;
}

.entry-row-full {
    width: 1fr;
}

.entry-row .entry-label {
    color: $primary;
}

.entry-row .entry-value {
    width: 1fr;
}

.entry-value{
    padding: 0 0 0 1;
}

/* ============================================================
   Dashboard: stats header
   (DashboardStatsContent, WidgetCommonStatLabel)
   ============================================================ */
#dashboard-stats-content {
    width: 1fr;
}

WidgetCommonStatLabel {
    width: 20;
}

WidgetCommonStatLabel .stat-key {
    color: $font-muted-color;
}

WidgetCommonStatLabel .stat-value {
    color: $secondary;
    text-style: bold;
}

/* ============================================================
   Dashboard: comms column
   (WidgetCommsCol, WidgetCommsEntry, WidgetCommsInput)
   ============================================================ */
#comms-scroll,
#ship-log-scroll {
    height: 1fr;
}

WidgetCommsEntry {
    height: auto;
    padding: 0 0 1 0;
}

.comms-input-container {
    height: 3;
}

#comms-thinking-indicator {
    height: 1;
    padding: 0 1;
    color: $secondary;
    text-style: italic;
}

.comms-entry-title {
    text-style: bold;
}

WidgetCommsEntry.user-command .comms-entry-title,
WidgetCommsEntry.user-command .comms-entry-content {
    color: $human-command-color;
}

WidgetCommsEntry.llm-response .comms-entry-title,
WidgetCommsEntry.llm-response .comms-entry-content {
    color: $primary;
}

WidgetCommsEntry.system-message .comms-entry-title,
WidgetCommsEntry.system-message .comms-entry-content {
    color: $font-muted-color;
}

WidgetCommsEntry.llm-action .comms-entry-title,
WidgetCommsEntry.llm-action .comms-entry-content {
    color: $accent;
}

WidgetCommsEntry.llm-error .comms-entry-title,
WidgetCommsEntry.llm-error .comms-entry-content {
    color: $error;
}

/* ============================================================
   Dashboard: ship log column
   (WidgetShipLogCol, WidgetShipLogEntry)
   ============================================================ */
WidgetShipLogCol {
    row-span: 2;
}

WidgetShipLogEntry {
    padding: 0 0 1 0;
}

WidgetShipLogEntry > Label {
    padding: 0 1 0 0;
}

WidgetShipLogEntry .log-timestamp {
    color: $font-muted-color;
}

WidgetShipLogEntry .log-event {
    text-style: bold;
}

/* ============================================================
   Settings: sections sidebar (WidgetSettingsSectionsColumn)
   ============================================================ */
.section-nav-item {
    color: $font-muted-color;
    padding: 0 0 1 0;
}

WidgetSettingsSectionListItem {
    width: 1fr;
}

WidgetSettingsSectionListItem .section-label {
    width: 1fr;
}

/* ============================================================
   Settings: paths section
   ============================================================ */
WidgetPathsContainer .entry-label {
    width: 20;
}

WidgetPathsContainer WidgetLabeledDynamicInputRow {
    margin-bottom: 1;
}

/* ============================================================
   Settings: TTS section
   Nested provider settings blocks must size to their own content
   (height: auto) so the outer VerticalScroll in WidgetTTSContainer
   can measure real content height and scroll when it overflows.
   Without this they inherit Vertical's default height: 1fr and
   clip their own rows instead of scrolling.
   ============================================================ */
WidgetChatterboxTTSSettingsVertical,
WidgetEdgeTTSSettingsVertical {
    height: auto;
}

/* Row types differ in intrinsic height (select: 1, switch: 2, slider: 1),
   so give them a shared bottom margin instead of relying on their own
   height to create the gap between rows — keeps the spacing uniform. */
WidgetChatterboxTTSSettingsVertical WidgetLabeledSelectRow,
WidgetChatterboxTTSSettingsVertical WidgetLabeledSwitchRow,
WidgetChatterboxTTSSettingsVertical WidgetLabeledSliderRow {
    margin-bottom: 1;
}

/* Slider defaults to a bordered, 3-row-tall widget (see textual_slider),
   the same trap Input's border fell into earlier in this file — override
   it to a flat 1-row track so the row height stays fixed and consistent
   with every other settings row. */
WidgetLabeledSliderRow {
    height: 1;
}

.entry-slider {
    width: 1fr;
    height: 1;
    min-height: 1;
    border: none;
    padding: 0;
}

/* ============================================================
   Settings: LLM section — multi-line prompt rows
   (WidgetLabeledTextAreaRow)
   TextArea defaults to height: 1fr, the same trap Input and Slider
   fell into above — pin it to a fixed number of rows instead, so a
   prompt editor doesn't try to swallow the rest of the screen.
   ============================================================ */
WidgetLabeledTextAreaRow {
    height: auto;
    margin-bottom: 1;
}

WidgetLabeledTextAreaRow .textarea-row-label-line {
    height: 1;
}

.entry-textarea {
    height: 6;
    min-height: 6;
    background: $panel;
}

/* ============================================================
   Settings: keybinds section
   ============================================================ */

WidgetKeybindsContainer .entry-row {
    padding: 1 0 0 0;
}

WidgetKeybindsContainer .entry-value {
    color: $primary;
    content-align: right middle;
}

WidgetLabeledDynamicInputRow {
    height: 1;
}

WidgetLabeledSelectRow {
    height: 1;
}

WidgetLabeledSwitchRow {
    height: 2;
}

WidgetLabeledSwitchRow .entry-label {
    width: 30;
}

WidgetLabeledSwitchRow Switch {
    padding: 0 2;
    border: none !important;
}

WidgetLabeledSwitchRow #settings-entry-value-container {
    width: 1fr;
    align: right middle;
}

#settings-entry-row-container Label {
    height: 1fr;
    content-align: left middle;
}

/* Input(compact=True) already sets border: none and height: 1 via its
   own CSS (see textual.widgets.Input) — nothing to override here. That
   keeps the row's height fixed whether it's showing the value or being
   edited, so nothing below it reflows when you click into a field. */

#settings-entry-row-container .entry-select{
    padding: 0;
    height: 1;
}

.warning-label {
    color: $warning;
}

.warning-label.error {
    color: $error;
    background: transparent;
}

.warning-label.success {
    color: $success;
    background: transparent;
}

.hidden{
    visibility: hidden;
}


#clone-voice-button{
    width: auto;
    min-width: 0;
    padding: 0;
    border: none;
    color: $success;
    background: transparent;
    &:hover{
        color: $secondary;
        background: transparent;
    }
}

.profile-row {
    height: 1;
    align: left middle;
}

.profile-row .profile-name {
    width: 1fr;
    color: $primary;
}

.profile-row Button {
    width: auto;
    min-width: 0;
    padding: 0 1;
    border: none;
    background: transparent;
    &:hover{
        color: $secondary;
        background: transparent;
    }
}

.profile-row .profile-play-button {
    color: $success;
}

.profile-row .profile-delete-button {
    color: $error;
}

.no-profiles-message {
    color: $font-muted-color;
    padding: 1 0;
}

#comms-input{
    width: 1fr;
}

#comms-stt-button{
    dock: right;
    color: red;
    width: 2;
    padding: 0;
    border: none;
    min-width: 10;
    height: 1fr;
    background: transparent;
    &:hover{
        background: transparent;
    }
    &.-active{
        background: transparent;
    }
}

VoiceCloneModalScreen{
    border: solid $secondary;
    border-title-align: left;
}

.voice-clone-phase-bar{
    height: auto;
    padding: 1 0;
}

.voice-clone-phase-dots{
    height: 1;
    align: center middle;
    color: $secondary;
}

.voice-clone-phase-labels{
    height: 1;
    align: center middle;
    color: $font-muted-color;
}

.voice-clone-phase-labels Label{
    padding: 0 1;
}

.voice-clone-phase-labels .-active{
    color: $secondary;
    text-style: bold;
}

.voice-clone-body{
    height: 1fr;
    align: center middle;
}

#clone-voice-confirm-button{
    width: auto;
    min-width: 0;
    padding: 0 1;
    border: none;
    color: $success;
    background: transparent;
    &:hover{
        color: $secondary;
        background: transparent;
    }
}

.voice-clone-footer{
    height: auto;
    align: left middle;
    border-top: solid $secondary;
    padding: 1 1 0 1;
}

.voice-clone-footer-left{
    width: 1fr;
    height: auto;
    align: left middle;
}

.voice-clone-footer-center{
    width: 1fr;
    height: auto;
    align: center middle;
}

.voice-clone-footer-right{
    width: 1fr;
    height: auto;
    align: right middle;
}

#voice-clone-cancel-button{
    width: auto;
    min-width: 0;
    padding: 0 1;
    border: none;
    color: $error;
    background: transparent;
    &:hover{
        color: $secondary;
        background: transparent;
    }
}

#voice-clone-pick-another-button{
    width: auto;
    min-width: 0;
    padding: 0 1;
    border: none;
    color: $warning;
    background: transparent;
    &:hover{
        color: $secondary;
        background: transparent;
    }
}

.voice-clone-hint-bar{
    height: 1;
    width: 100%;
    content-align: center middle;
    color: $font-muted-color;
}

.analysis-phase-body{
    height: auto;
    width: 100%;
    padding: 0 2;
}

.analysis-heading{
    color: $font-muted-color;
}

.analysis-file-name{
    text-style: bold;
    color: $primary;
}

.analysis-file-dir{
    color: $font-muted-color;
    padding-bottom: 1;
}

#analysis-waveform{
    height: 3;
}

#analysis-waveform > .sparkline--max-color{
    color: $warning;
}

#analysis-waveform > .sparkline--min-color{
    color: $warning 30%;
}

.analysis-waveform-time-row{
    height: 1;
    color: $font-muted-color;
    padding-bottom: 1;
}

.analysis-waveform-time-start{
    width: 1fr;
}

.analysis-waveform-time-end{
    width: 1fr;
    content-align: right middle;
}

.analysis-check-row{
    height: 1;
}

.analysis-check-icon{
    width: 3;
}

.analysis-check-label{
    width: 14;
    color: $font-muted-color;
}

.analysis-check-value{
    width: 16;
}

.analysis-check-hint{
    color: $font-muted-color;
}

#analysis-play-button{
    width: auto;
    min-width: 0;
    padding: 0 1;
    border: none;
    color: $success;
    background: transparent;
    &:hover{
        color: $secondary;
        background: transparent;
    }
}

.analysis-error-hint{
    color: $error;
    padding-top: 1;
}

.save-toggle-row{
    height: auto;
    padding: 1 0;
}

#compare-play-source-button,
#compare-play-sample-button{
    width: auto;
    min-width: 0;
    padding: 0 1;
    border: none;
    color: $success;
    background: transparent;
    &:hover{
        color: $secondary;
        background: transparent;
    }
}

#save-regenerate-button{
    width: auto;
    min-width: 0;
    padding: 0 1;
    border: none;
    color: $warning;
    background: transparent;
    &:hover{
        color: $secondary;
        background: transparent;
    }
}
