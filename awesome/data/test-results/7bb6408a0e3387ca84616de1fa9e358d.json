 async def test_should_cut_celeste_off_when_the_commander_sends_a_message(edceleste):\n        with allure.step(\"Given Celeste has a voice on a GPU and a slow speaker\"):\n            celeste_speaks_with_a_voice_on_a_gpu(edceleste)\n            chatterbox = edceleste.fake_tts_providers[\"chatterbox\"]\n            speaker = edceleste.fake_speaker\n    \n        with allure.step(\"And the LLM answers the first and then the second message\"):\n            edceleste.use_scripted_model(answer_with(LONG_ANSWER, SECOND_ANSWER))\n    \n        async with edceleste.run_app() as pilot:\n            await edceleste.boot_to_dashboard(pilot, step_keyword=\"And\")\n            spoken_at_boot = len(edceleste.spoken_texts)\n            await game_writes_first_status_file(edceleste, pilot, flags=0)\n    \n            with allure.step(\"And Celeste is in the middle of saying the first answer\"):\n                await celeste_is_saying_the_answer(\n                    edceleste, pilot, TELL_ME_ABOUT_THE_SYSTEM\n                )\n    \n            with allure.step(\"And the game reports the gear down, Celeste has to wait\"):\n                await game_reports_the_gear_down_while_celeste_speaks(edceleste, pilot)\n    \n            with allure.step(\"When the Commander types another message in COMMS\"):\n                await send_comms_message(pilot, \"and the next system?\")\n                await edceleste.wait_until(\n                    pilot,\n                    lambda: len(comms_entries(pilot.app, \"llm-response\")) == 2,\n                    \"the second answer in COMMS\",\n                )\n                speaker.let_playing_go_on()\n    \n            with allure.step(\"Then the first answer is cut and the second one is said\"):\n>               await edceleste.wait_until(\n                    pilot, lambda: speaker.times_closed == 2, \"the second voice played\"\n                )\n\ntests/e2e/test_voice_queue.py:276: \n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \n\nself = <tests.e2e.conftest.EdCelesteTestEnvironment object at 0x7fb89b7780e0>\npilot = <Pilot app=UIApp(title='UIApp', classes={'-dark-mode', '-theme-amber'}, pseudo_classes={'dark', 'focus'})>\ncondition = <function test_should_cut_celeste_off_when_the_commander_sends_a_message.<locals>.<lambda> at 0x7fb89b55e020>\ndescription = 'the second voice played', timeout_seconds = 5\n\n    async def wait_until(\n        self,\n        pilot: Pilot,\n        condition: Callable[[], bool],\n        description: str,\n        timeout_seconds: float = 5,\n    ) -> None:\n        # Not app.workers.wait_for_complete(): the dashboard workers stream\n        # forever and never complete\n        with allure.step(f\"Wait for {description}\"):\n            give_up_at = time.monotonic() + timeout_seconds\n            while not condition():\n                if time.monotonic() > give_up_at:\n>                   pytest.fail(f\"Waited {timeout_seconds} s for: {description}\")\nE                   Failed: Waited 5 s for: the second voice played\n\ntests/e2e/conftest.py:857: Failed","start":1793216896081,"stop":1793216907896,"duration":11815,"labels":[{"name":"feature","value":"Voice queue"},{"name":"tag","value":"anyio"},{"name":"parentSuite","value":"tests.e2e"},{"name":"suite","value":"test_voice_queue"},{"name":"host","value":"runnervm48cm3"},{"name":"thread","value":"3837-MainThread"},{"name":"framework","value":"pytest"},{"name":"language","value":"cpython3"},{"name":"package","value":"tests.e2e.test_voice_queue"}],"url":"","retryHash":"026f8e50ab4f17daedc8299080cb289a.d41d8cd98f00b204e9800998ecf8427e","reportLinks":[]},{"id":"2481f0fa96ba3fc922473d19547901cd","name":"A message typed while Celeste speaks cuts her off","fullName":"tests.e2e.test_voice_queue#test_should_cut_celeste_off_when_the_commander_sends_a_message","environment":"default","status":"passed","start":1793141719627,"stop":1793141727933,"duration":8306,"labels":[{"name":"feature","val